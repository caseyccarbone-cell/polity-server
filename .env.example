# Required
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Speech-to-text: set ONE of these. Deepgram is recommended (fast, accepts raw WAV, custom key terms).
DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# STT_PROVIDER=deepgram        # deepgram | openai | groq  (auto-detected from which key is set)
# STT_MODEL=nova-3

# Optional shared secret. If set, the plugin must send it as VITE_APP_TOKEN.
APP_TOKEN=

PORT=8787
